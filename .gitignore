# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify — also read as .graphifyignore fallback
graphify-out/

# nested installs (scripts/)
node_modules/

# local-only: planning docs, agent/tool config, backups, personal config
*.bkp
foundation/
foundation-no-graph/
.claude/
CLAUDE.local.md
config/pillars.json

# keep the env template
!.env.example
orca.yaml
