# Copy to .env — docker compose reads it automatically.

# Postgres password (used by both containers). Change it.
POSTGRES_PASSWORD=changeme

# Host ports
DB_PORT=5433
APP_PORT=3030

# For `npm run dev` / `npm run migrate` / `npm run seed` outside Docker
DATABASE_URL=postgresql://analytics:changeme@localhost:5433/analytics

# Browser tab title
DASHBOARD_TITLE=Social Analytics

# Content-category keywords. Defaults to config/pillars.json, then config/pillars.example.json
# PILLARS_FILE=config/pillars.json
